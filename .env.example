# Nexus — environment config
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Anthropic API — used by the Conductor for task classification
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Elysium runtime — the agent execution layer at aegisnet.org.uk
# ELYSIUM_URL and ELYSIUM_API_KEY are read by the Electron main process
# (not Vite) so they do NOT need the VITE_ prefix.
ELYSIUM_URL=https://elysium.aegisnet.org.uk
ELYSIUM_API_KEY=your_elysium_api_key_here
